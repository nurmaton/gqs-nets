       "Column"]},
     {
      StyleBox[
       TemplateBox[{
        "\"The right-hand sides of the first four identities are, up to sign, \
numbers  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"(", 
                RowBox[{
                  RowBox[{"(", 
                    RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "\[PlusMinus]", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}], "\[PlusMinus]", 
                  SubscriptBox["\[Gamma]", "i"]}], ")"}], "\[PlusMinus]", 
              SubscriptBox["\[Delta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\" ,  which are  \[NotEqual] 0  (mod 2\[Pi])  by the hypothesis and \
Claim 1;  hence  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["\[Sigma]", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Alpha]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Gamma]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Delta]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  are not in  \[Pi]\[DoubleStruckCapitalZ],  and their sines are \
nonzero.  Since the sines of the barred numbers are nonzero by Claim 2, it \
follows from the last two identities that  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["f", "i"], "\[NotEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["M", "i"], "\[NotEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" .  Hence  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["\[CurlyEpsilon]", "i"], "\[LongEqual]", 
                TemplateBox[{
                  RowBox[{"sin", "(", 
                    SubscriptBox["\[Sigma]", "i"], ")"}]}, "Sign"]}], 
              "\[Element]", 
              RowBox[{"{", 
                RowBox[{"\[PlusMinus]", "1"}], "}"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["z", "i"], "\[LongEqual]", 
              FractionBox["1", 
               RowBox[{
                 SubscriptBox["f", "i"], "-", "1"}]]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  is well defined and nonzero, and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"\[Chi]", "\[Element]", 
              RowBox[{"{", 
                RowBox[{"\[PlusMinus]", "1"}], "}"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" .  Together, these give Claim 3.\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]}
    },
