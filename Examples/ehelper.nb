 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox[
        "\"Claim 3:  the half sums, the quantities  \
\\!\\(\\*SubscriptBox[\\(f\\), \\(i\\)]\\)  and  \
\\!\\(\\*SubscriptBox[\\(M\\), \\(i\\)]\\)\"", Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Verification:  the following identities hold for an \
arbitrary quadruple, hence at each vertex  i = 1, 2, 3, 4 :\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      TagBox[GridBox[{
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    SubscriptBox["\[Sigma]", "i"]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "+", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    RowBox[{"-", 
                    SubscriptBox["\[Alpha]", "i"]}], "-", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "-", 
                    SubscriptBox["\[Beta]", "i"], "-", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "-", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "-", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{
                    SubscriptBox["f", "i"], "-", "1"}], "\[LongEqual]", 
                  FractionBox[
                   RowBox[{
                    RowBox[{"sin", "(", 
                    SubscriptBox["\[Sigma]", "i"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], 
                   RowBox[{
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], ")"}]}]]}], 
                HoldForm], TraditionalForm], TraditionalForm, Editable -> 
              True], "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
