           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox[
           TemplateBox[{"\"by (5), because \"", 
             TagBox[
              SubscriptBox[
               StyleBox["p", FontSlant -> "Italic"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SqrtBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["r", FontSlant -> "Italic"], 
                  StyleBox["i", FontSlant -> "Italic"]], "-", "1"}]], 
              DisplayForm], "\" and \"", 
             TagBox[
              SubscriptBox[
               StyleBox["q", FontSlant -> "Italic"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SqrtBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["s", FontSlant -> "Italic"], 
                  StyleBox["i", FontSlant -> "Italic"]], "-", "1"}]], 
              DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(9)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["t", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["t", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox[
           TemplateBox[{"\"dn\[ThinSpace]\"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["t", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" = dn\[ThinSpace]\"", 
             TagBox[
              SubscriptBox[
               StyleBox["t", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\", because \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["f", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["f", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" and \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["M", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["M", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" by (5); the interval is the same, because \"", 
             TemplateBox[{
               TagBox[
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["p", FontSlant -> "Italic"], "^"], 
                 StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
               "\"\[ThinSpace]\"", 
               TagBox[
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", FontSlant -> "Italic"], "^"], 
                 StyleBox["i", FontSlant -> "Italic"]], DisplayForm]}, 
              "RowDefault"], "\" = \"", 
             TemplateBox[{
               TagBox[
                SubscriptBox[
                 StyleBox["p", FontSlant -> "Italic"], 
                 StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
               "\"\[ThinSpace]\"", 
               TagBox[
                SubscriptBox[
                 StyleBox["q", FontSlant -> "Italic"], 
                 StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm]}, 
              "RowDefault"], "\" by (8) and \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Sigma]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox["\[Sigma]", 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" by (2)\""},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(10)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"(\"", 
             TagBox[
              OverscriptBox[
               StyleBox["Z", FontSlant -> "Italic"], "^"], DisplayForm], 
             "\", \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["W", FontSlant -> "Italic"], "^"], "2"], 
              DisplayForm], "\", \"", 
