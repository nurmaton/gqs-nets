                    TemplateBox[{"g", "j", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}]}], ">", "0"}], 
            HoldForm], TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and, by  \"", 
         StyleBox["\"the given sign identities\"", Italic, 12, 
          RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
         "\" ,  the factors have the signs of  \"", 
