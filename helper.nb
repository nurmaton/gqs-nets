           TagBox["t", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"Because  \"", 
