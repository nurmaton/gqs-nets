                    TemplateBox[{"g", "3", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}]}]}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  if and only if  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"u", " ", 
                SubscriptBox["z", "2"], " ", 
                SubscriptBox["z", "3"]}], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\" .\""},
        "RowDefault"],
       StripOnInput->False,
       LineColor->GrayLevel[0.35],
       FrontFaceColor->GrayLevel[0.35],
       BackFaceColor->GrayLevel[0.35],
       GraphicsColor->GrayLevel[0.35],
       FontSize->12,
       FontColor->GrayLevel[0.35]]},
     {
      StyleBox[
       TemplateBox[{"\"Thus, when  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"u", "<", "0"}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" ,  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["h", "233"], "\[LongEqual]", "0"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  if and only if  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"u", " ", 
                SubscriptBox["z", "2"], " ", 
                SubscriptBox["z", "3"]}], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["e", "2"], "\[LongEqual]", 
              SubscriptBox["e", "3"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\" .  Therefore, in cases (i) and (ii) below,  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["h", "233"], "\[NotEqual]", "0"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" ,  and the identity  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["h", "233"], " ", 
                SubscriptBox["H", "3"]}], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  gives  \"", 
