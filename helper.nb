               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "3"], DisplayForm], "\")\""}, "RowDefault"], TraditionalForm], 
           FormBox[
            TemplateBox[{
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "1"], DisplayForm], "\"|\""}, "RowDefault"], 
              "\"\[ThinSpace]\"", 
              TemplateBox[{"\"|\"", 
