       RowBox[{
        RowBox[{"eps", "^", "2"}], "*", 
        RowBox[{"Sin", "[", "sigma", "]"}]}], "=", 
       RowBox[{
        RowBox[{"Sin", "[", "sigma", "]"}], " ", 
        RowBox[{
         RowBox[{"(", "cancellation", ")"}], ".", "No"}], " ", "Sqrt", " ", 
        "over", " ", "trigonometric", " ", "arguments", " ", "reaches", " ", 
        "the", " ", 
        RowBox[{"kernel", "."}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isTrueQeps", "[", 
      RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "u", ",", "v"}], "}"}], ",", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"rad", "==", "sq"}], ",", 
           RowBox[{"Assumptions", "->", "assumptions"}]}], "]"}], "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"Assuming", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", ">", "0"}], "&&", 
            RowBox[{"v", ">", "0"}]}], ",", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"u", "/", "v"}], ">", "0"}], "]"}]}], "]"}], "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"Assuming", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "<", "0"}], "&&", 
            RowBox[{"v", ">", "0"}]}], ",", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"u", "/", "v"}], "<", "0"}], "]"}]}], "]"}], "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"Assuming", "[", 
          RowBox[{
           RowBox[{"t", ">", "0"}], ",", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"t", "^", "2"}], "]"}], "==", "t"}], "]"}]}], "]"}], 
         "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"Assuming", "[", 
          RowBox[{
           RowBox[{"t", "<", "0"}], ",", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"t", "^", "2"}], "]"}], "==", 
             RowBox[{"-", "t"}]}], "]"}]}], "]"}], "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sin", "[", "\[Sigma]", "]"}], "/", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Sigma]", "-", "\[Delta]"}], "]"}]}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Sigma]", "-", "\[Delta]"}], "]"}]}], "==", 
           RowBox[{"Sin", "[", "\[Sigma]", "]"}]}], "]"}], "]"}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"PART", " ", "2"}], ":", 
     RowBox[{
     "THE", " ", "RADICAND", " ", "AND", " ", "THE", " ", "IDENTITY"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"identities", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Radicand equals a perfect square\>\"", ",", 
         RowBox[{"HoldForm", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"f", "-", "M"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"r", "-", "1"}], ")"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s", "-", "1"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"f", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "M"}], ")"}]}], ")"}]}]}], "]"}], ",", 
         RowBox[{"HoldForm", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sin", "[", "\[Sigma]", "]"}], "/", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Sigma]", "-", "\[Delta]"}], "]"}]}], ")"}], "^", 
           "2"}], "]"}], ",", "isTrueQ"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Identity for sin(\[Sigma]) (via the radicand row)\>\"", ",", 
         RowBox[{"HoldForm", "[", 
          RowBox[{"Sin", "[", "\[Sigma]", "]"}], "]"}], ",", 
         RowBox[{"HoldForm", "[", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"f", "-", "M"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"r", "-", "1"}], ")"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"s", "-", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"f", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "M"}], ")"}]}], ")"}]}]}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Sigma]", "-", "\[Delta]"}], "]"}]}], "]"}], ",", 
         "isTrueQeps"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\n", 
   RowBox[{"(*", 
