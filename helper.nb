             SubscriptBox["e", "2"], " ", 
             SubscriptBox["H", "1"], " ", 
             SqrtBox[
              RowBox[{
               SubscriptBox["x", "1"], " ", 
               RowBox[{"\[ScriptCapitalD]", "(", 
                RowBox[{
                 SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], 
           "\[LongEqual]", 
