              FractionBox[
               FormBox[
                TemplateBox[{"\"(1 + \"", 
                  TagBox[
                   RowBox[{
                    SuperscriptBox["cot", "2"], "(", 
                    SubscriptBox["\[Theta]", "4"], "/", "2", ")"}], 
                   DisplayForm], "\")(1 + \"", 
                  TagBox[
                   RowBox[{
