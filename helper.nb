          StyleBox[
           TemplateBox[{"\"so, by (8), for a fixed value of one variable, \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], 
                 StyleBox["i", FontSlant -> "Italic"]], "(", 
                StyleBox["X", FontSlant -> "Italic"], ", ", 
                StyleBox["Y", FontSlant -> "Italic"], ")"}], DisplayForm], 
             "\" is a nonzero polynomial of degree at most 2 in the other: \
its constant coefficient is \"", 
             TagBox[
              SubscriptBox[
               StyleBox["c", FontSlant -> "Italic"], 
               RowBox[{"00", 
                 StyleBox["i", FontSlant -> "Italic"]}]], DisplayForm], 
             "\" when the fixed value is 0, and its linear coefficient is not \
0 otherwise\""},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(10)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TemplateBox[{"\"cot(\"", 
               TagBox[
                SubscriptBox["\[Theta]", 
                 StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
               "\"/2)\""}, "RowDefault"], "\" is linked to \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], "\" = \"", 
             TagBox[
              StyleBox["Z", FontSlant -> "Italic"], DisplayForm], "\" by \"", 
             
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "2"], "(", 
                StyleBox["Z", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "2"], ")"}], 
              DisplayForm], "\" = 0 for j = 1, by \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "2"], "(", 
                StyleBox["Z", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "2"], ")"}], 
              DisplayForm], "\" = \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "3"], "(", 
                StyleBox["U", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "2"], ")"}], 
              DisplayForm], "\" = 0 for j = 2, and by \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "1"], "(", 
                StyleBox["Z", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "1"], ")"}], 
              DisplayForm], "\" = 0 for j = 3\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox[
           TemplateBox[{"\"by (3) and (c), because \"", 
             TemplateBox[{"\"cot(\"", 
               TagBox[
                SubscriptBox["\[Theta]", 
                 StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
               "\"/2)\""}, "RowDefault"], "\" is \"", 
             TagBox[
              SubscriptBox[
               StyleBox["W", FontSlant -> "Italic"], "2"], DisplayForm], 
             "\", \"", 
             TagBox[
              StyleBox["U", FontSlant -> "Italic"], DisplayForm], "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["W", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\" for j = 1, 2, 3, respectively\""},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(11)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"each value of \"", 
             TemplateBox[{"\"cot(\"", 
               TagBox[
                SubscriptBox["\[Theta]", 
                 StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
               "\"/2)\""}, "RowDefault"], 
             "\" is taken for at most two values of \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
             "\" for odd j, and for at most four for j = 2\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox["\<\"by (9) and (10)\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {"\<\"\"\>", 
          TemplateBox[{0, 7},
           "Spacer2"], "\<\"\"\>", "\<\"\"\>"},
         {
          StyleBox["\<\"(12)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"the admissible \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
             "\" for which some polyhedron of the flexion with the parameter \
\"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], "\" has \"", 
             TemplateBox[{"\"cot(\"", 
               TagBox[
                SubscriptBox["\[Theta]", 
                 StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
               "\"/2)\""}, "RowDefault"], 
             "\" in the finite set of (7) form a finite set\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox["\<\"by (11), applied to each value of this finite set\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(13)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"for every other admissible \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
             "\", every polyhedron of the flexion with the parameter \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
             "\" is a polyhedron of the flexion formed after the permutation \
by j, with \"", 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], 
               StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
             "\", \[Ellipsis], \"", 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], 
               StyleBox["4+j", FontSlant -> "Italic"]], DisplayForm], 
             "\" in place of \"", 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\", \[Ellipsis], \"", 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], "4"], DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox[
           TemplateBox[{"\"by (6), because for such \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
             "\" the value \"", 
             TemplateBox[{"\"cot(\"", 
               TagBox[
                SubscriptBox["\[Theta]", 
                 StyleBox["1+j", FontSlant -> "Italic"]], DisplayForm], 
               "\"/2)\""}, "RowDefault"], 
             "\" is not in the finite set of (7), so it is admissible after \
the permutation\""},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]}
        },
        AutoDelete->False,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
        GridBoxSpacings->{"Columns" -> {{1.2}}, "Rows" -> {{0.8}}}],
       "Grid"]},
     {
      StyleBox["\<\"Together, these give the claim.\"\>",
       StripOnInput->False,
       FontSize->13]}
    },
