     {
      StyleBox[
       TemplateBox[{"\"The definition gives \[Theta](\"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "1"], 
          DisplayForm], "\", \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "2"], 
          DisplayForm], "\", \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "3"], 
          DisplayForm], "\") = \[PlusMinus]\[Angle](\"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "1"], 
          DisplayForm], "\", \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "2"], 
          DisplayForm], 
         "\"), by the sign of the determinant. The cosine is even and the \
sine is odd, so cos \[Theta] = \"", 
         TagBox[
          FractionBox[
           FormBox[
            TemplateBox[{
              TagBox[
               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "1"], DisplayForm], "\" \[CenterDot] \"", 
              TagBox[
               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "2"], DisplayForm]}, "RowDefault"], TraditionalForm], 
           FormBox[
            TemplateBox[{
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "1"], DisplayForm], "\"|\""}, "RowDefault"], 
              "\"\[ThinSpace]\"", 
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "2"], DisplayForm], "\"|\""}, "RowDefault"]}, 
             "RowDefault"], TraditionalForm]], DisplayForm], 
         "\" and sin \[Theta] = \"", 
         TagBox[
          FractionBox[
           FormBox[
            TemplateBox[{"\"det(\"", 
              TagBox[
               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "1"], DisplayForm], "\", \"", 
              TagBox[
               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "2"], DisplayForm], "\", \"", 
              TagBox[
               SubscriptBox[
                OverscriptBox[
                 StyleBox["w", FontSlant -> "Italic"], 
                 AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], 
                "3"], DisplayForm], "\")\""}, "RowDefault"], TraditionalForm], 
           FormBox[
            TemplateBox[{
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "1"], DisplayForm], "\"|\""}, "RowDefault"], 
              "\"\[ThinSpace]\"", 
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "2"], DisplayForm], "\"|\""}, "RowDefault"], 
              "\"\[ThinSpace]\"", 
              TemplateBox[{"\"|\"", 
                TagBox[
                 SubscriptBox[
                  OverscriptBox[
                   StyleBox["w", FontSlant -> "Italic"], 
                   AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]],
                   "3"], DisplayForm], "\"|\""}, "RowDefault"]}, 
             "RowDefault"], TraditionalForm]], DisplayForm], 
         "\" hold whichever sign the determinant has; the formula for the \
sine holds because \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "3"], 
          DisplayForm], 
         "\", the direction of an edge common to the two faces, is orthogonal \
to \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "1"], 
          DisplayForm], "\" and \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "2"], 
          DisplayForm], "\", so that \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "1"], 
          DisplayForm], "\" \[Cross] \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "2"], 
          DisplayForm], "\" is a multiple of \"", 
         TagBox[
          SubscriptBox[
           OverscriptBox[
            StyleBox["w", FontSlant -> "Italic"], 
            AdjustmentBox["\[RightArrow]", BoxBaselineShift -> -0.16]], "3"], 
          DisplayForm], 
         "\". No formula of the notebook distinguishes the two cases, the \
coordinates above included.\""},
