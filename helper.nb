          FormBox[
           TagBox["t", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True], "\"-dependent denominators  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["z", "2"], " ", 
