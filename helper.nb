     {
      StyleBox[
       TemplateBox[{"\"Thus, substituting the product identities  \"", 
         StyleBox["\"\[FilledCircle]\"", 13, 
          RGBColor[0.55, 0.33, 0.1], StripOnInput -> False], 
         "\"  and the verified equality for  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"1", "-", 
