                    SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], ")"}]}], 
             SqrtBox[
              RowBox[{
               SubscriptBox["z", "2"], " ", 
               SubscriptBox["z", "3"]}]]]}]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
