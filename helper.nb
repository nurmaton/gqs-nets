               SuperscriptBox["k", "2"]], "\[LongEqual]", 
              RowBox[{"-", 
                FractionBox[
                 RowBox[{"1", "-", "u"}], 
                 RowBox[{"u", " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    SubscriptBox["z", "i"]}], ")"}]}]]}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\"   \"", 
         StyleBox["\"\[CheckmarkedBox]\"", 14, 
