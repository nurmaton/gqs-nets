               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], "\")\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
           FontSize->14,
           FontColor->RGBColor[0.13, 0.55, 0.13]], 
          StyleBox["\<\"by (5)\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(7)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["\[CurlyEpsilon]", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["\[CurlyEpsilon]", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox[
           TemplateBox[{"\"by (2), because \"", 
             TagBox[
              SubscriptBox[
               StyleBox["\[CurlyEpsilon]", FontSlant -> "Italic"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" = sign(sin\[ThinSpace]\"", 
             TagBox[
              SubscriptBox["\[Sigma]", 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\")\""},
            "RowDefault"],
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(8)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"(\"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["p", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\", \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["q", FontSlant -> "Italic"], "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\") = (\"", 
             TagBox[
              SubscriptBox[
               StyleBox["q", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["p", FontSlant -> "Italic"], 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\"),   \"", 
             TemplateBox[{
               TagBox[
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["p", FontSlant -> "Italic"], "^"], 
                 StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
               "\"\[ThinSpace]\"", 
               TagBox[
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["q", FontSlant -> "Italic"], "^"], 
                 StyleBox["i", FontSlant -> "Italic"]], DisplayForm]}, 
              "RowDefault"], "\" = \"", 
             TemplateBox[{
               TagBox[
                SubscriptBox[
                 StyleBox["p", FontSlant -> "Italic"], 
                 StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
               "\"\[ThinSpace]\"", 
               TagBox[
                SubscriptBox[
                 StyleBox["q", FontSlant -> "Italic"], 
                 StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm]}, 
              "RowDefault"]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
