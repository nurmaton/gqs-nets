         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Given hypotheses, in addition to those above:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
