          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Given hypotheses and formulas, in addition to those \
above:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SuperscriptBox[
                 RowBox[{"sn", "(", "v", ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"cn", "(", "v", ")"}], "2"]}], "\[LongEqual]", "1"}],
             HoldForm], TraditionalForm], TraditionalForm, Editable -> True], 
         "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"dn", "(", "v", ")"}], "2"], "\[LongEqual]", 
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   SuperscriptBox["k", "\[Prime]", MultilineFunction -> None],
                    ")"}], "2"], "+", 
                RowBox[{
                  SuperscriptBox["k", "2"], " ", 
                  SuperscriptBox[
                   RowBox[{"cn", "(", "v", ")"}], "2"]}]}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\"    \"", 
         StyleBox["\"the Pythagorean relations\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["x", "1"], " ", 
                
                TemplateBox[{"p", "1", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox]}], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "\[LongEqual]", 
              FractionBox["t", 
               SubscriptBox["p", "1"]]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"], 
              "\[LongEqual]", 
              RowBox[{
                SubscriptBox["x", "1"], " ", 
                SuperscriptBox["t", "2"]}]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {"\<\"\"\>"},
     {
      StyleBox["\<\"Verification:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{"\"By  \"", 
         StyleBox["\"the Pythagorean relations\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "2"], "\[LongEqual]", 
              RowBox[{
                RowBox[{"-", "u"}], " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SuperscriptBox["k", "\[Prime]", MultilineFunction -> None],
                    ")"}], "2"]}]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  we have\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["p", "1"], " ", 
              RowBox[{"sn", "(", "\[FinalSigma]", ")"}], " ", 
              RowBox[{"dn", "(", "\[FinalSigma]", ")"}]}], ")"}], "2"], 
           "\[LongEqual]", 
           RowBox[{
            TemplateBox[{"p", "1", "2"},
             "Subsuperscript"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SuperscriptBox[
               RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"]}], ")"}], " ", 
            
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SuperscriptBox["k", "\[Prime]",
                 MultilineFunction->None], ")"}], "2"], "+", 
              RowBox[{
               SuperscriptBox["k", "2"], " ", 
               SuperscriptBox[
                RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"]}]}], ")"}]}], 
           "\[LongEqual]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                SuperscriptBox["k", "\[Prime]",
                 MultilineFunction->None], ")"}], "2"], " ", 
              SubscriptBox["x", "1"], " ", 
              RowBox[{"\[ScriptCapitalD]", "(", 
               RowBox[{
                SubscriptBox["x", "1"], ",", "t"}], ")"}]}], 
             TemplateBox[{"x", "1", "2"},
              "Subsuperscript"]]}], "\[LongEqual]", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[ImaginaryI]", " ", 
               SuperscriptBox["k", "\[Prime]",
                MultilineFunction->None], " ", "R"}], 
              TemplateBox[{
                SubscriptBox["x", "1"]},
               "Abs"]], ")"}], "2"]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       FontSize->14]},
     {
      StyleBox[
       TemplateBox[{"\"By  \"", 
         StyleBox["\"the parity formulas\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], 
         "\",  replacing  \"", 
         TagBox[
          FormBox[
           TagBox["\[FinalSigma]", HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\"  by  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"-", "\[FinalSigma]"}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\"  preserves  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"cn", "(", "\[FinalSigma]", ")"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and reverses the sign of  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"sn", "(", "\[FinalSigma]", ")"}], " ", 
              RowBox[{"dn", "(", "\[FinalSigma]", ")"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\" .\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"Thus, we may fix  \"", 
         StyleBox[
          TagBox[
           FormBox[
            TagBox[
             RowBox[{
               RowBox[{
                 SubscriptBox["p", "1"], " ", 
                 RowBox[{"sn", "(", "\[FinalSigma]", ")"}], " ", 
                 RowBox[{"dn", "(", "\[FinalSigma]", ")"}]}], "\[LongEqual]", 
               
               RowBox[{"-", 
                 FractionBox[
                  RowBox[{
                    SubscriptBox["e", "0"], " ", "\[ImaginaryI]", " ", 
                    SuperscriptBox[
                    "k", "\[Prime]", MultilineFunction -> None], " ", "R"}], 
                  TemplateBox[{
                    SubscriptBox["x", "1"]}, "Abs"]]}]}], HoldForm], 
            TraditionalForm], TraditionalForm, Editable -> True], 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], 
         "\",  so that the two values of  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["e", "0"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  correspond to the two admissible choices of  \"", 
         TagBox[
          FormBox[
           TagBox["\[FinalSigma]", HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" .\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{
        "\"The middle equality of the displayed chain, that is,  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                
                TemplateBox[{"p", "1", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox], " ", 
                RowBox[{"(", 
                  RowBox[{"1", "-", 
                    SuperscriptBox[
                    RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"]}], ")"}], 
                " ", 
                RowBox[{"(", 
                  RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    SuperscriptBox[
                    "k", "\[Prime]", MultilineFunction -> None], ")"}], "2"], 
                    "+", 
                    RowBox[{
                    SuperscriptBox["k", "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"]}]}], 
                  ")"}]}], "\[LongEqual]", 
              RowBox[{"-", 
                FractionBox[
                 RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    SuperscriptBox[
                    "k", "\[Prime]", MultilineFunction -> None], ")"}], "2"], 
                   " ", 
                   SubscriptBox["x", "1"], " ", 
                   RowBox[{"\[ScriptCapitalD]", "(", 
                    RowBox[{
                    SubscriptBox["x", "1"], ",", "t"}], ")"}]}], 
                 
                 TemplateBox[{"x", "1", "2"}, "Subsuperscript", SyntaxForm -> 
                  SubsuperscriptBox]]}]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\" ,  is verified on each sign region:\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      TagBox[GridBox[{
         {
          StyleBox[
           TagBox[
            FormBox[
