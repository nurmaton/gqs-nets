     {"\<\"\"\>"},
     {
      StyleBox[
       TemplateBox[{"\"Thus, substituting the identities  \"", 
         StyleBox["\"\[FilledCircle]\"", 13, 
          RGBColor[0., 0.45, 0.25], StripOnInput -> False], 
         "\"  into the numerator and the denominator of \"", 
         StyleBox["\"the given U-formula\"", Italic, 13, 
          RGBColor[0.85, 0.45, 0.], StripOnInput -> False], "\", we get\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox["\<\"the numerator identity:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{
            RowBox[{
             TemplateBox[{
               SubscriptBox["x", "1"]},
              "Abs"], " ", 
             SubscriptBox["H", "2"], " ", 
             SubscriptBox["H", "3"], " ", "t"}], "+", 
            RowBox[{
             SubscriptBox["e", "0"], " ", 
             SubscriptBox["e", "2"], " ", 
             SubscriptBox["H", "1"], " ", 
             SqrtBox[
              RowBox[{
               SubscriptBox["x", "1"], " ", 
               RowBox[{"\[ScriptCapitalD]", "(", 
                RowBox[{
                 SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], 
           "\[LongEqual]", 
           RowBox[{
            RowBox[{"-", 
             SubscriptBox["\[Xi]", "23"]}], " ", 
            SqrtBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["z", "2"], " ", 
                 SubscriptBox["z", "3"]}]},
              "Abs"]], " ", 
            TemplateBox[{"H", "3", "2"},
             "Subsuperscript"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               TemplateBox[{
                 SubscriptBox["x", "1"]},
                "Abs"], " ", 
               SubscriptBox["h", "232"], " ", "t"}], "+", 
              RowBox[{
               SubscriptBox["e", "0"], " ", 
               SuperscriptBox["k", "\[Prime]",
                MultilineFunction->None], " ", 
               SubscriptBox["h", "231"], " ", 
               SubscriptBox["h", "233"], " ", 
               SqrtBox[
                RowBox[{
                 SubscriptBox["x", "1"], " ", 
                 RowBox[{"\[ScriptCapitalD]", "(", 
                  RowBox[{
                   SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], ")"}]}]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
