     {
      StyleBox[
       TemplateBox[{"\"Here  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["\[Xi]", "23"], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\",  because  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "2"], "\[LongEqual]", 
              RowBox[{
                RowBox[{"(", 
                  RowBox[{
                    
                    TemplateBox[{"g", "2", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}], " ", 
                RowBox[{"(", 
                  RowBox[{
                    
                    TemplateBox[{"g", "3", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}]}], ">", "0"}], 
            HoldForm], TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                
                TemplateBox[{"g", "i", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox], "-", "1"}], "\[LongEqual]", 
              RowBox[{"-", 
                FractionBox["1", 
