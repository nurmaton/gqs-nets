          TraditionalForm, Editable -> True], "\",  so  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["z", "2"], " ", 
                SubscriptBox["z", "3"]}], ">", "0"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" .  The eight sign regions cover both cases.\""},
