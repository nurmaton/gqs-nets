         {
          StyleBox["\<\"and, finally, the prefactor identity:\"\>",
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TagBox[
            FormBox[
             TagBox[
              RowBox[{
               RowBox[{
                TagBox[
