   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Every", " ", "check", " ", "below", " ", "is", " ", "a", " ", 
      "rational", " ", "identity", " ", "in", " ", "a", " ", "fixed", " ", 
      "set", " ", "of", " ", "radical", " ", "atoms"}], ",", 
