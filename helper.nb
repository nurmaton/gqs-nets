                  "Subsuperscript"], "-", "1"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 TemplateBox[{"g", "3", "2"},
                  "Subsuperscript"], "-", "1"}], ")"}]}]}], ")"}]}], 
           "\[LongEqual]", 
           FractionBox[
            RowBox[{"1", "-", 
             RowBox[{"u", " ", 
              SubscriptBox["z", "2"], " ", 
              SubscriptBox["z", "3"]}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "u"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               SubscriptBox["z", "2"]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               SubscriptBox["z", "3"]}], ")"}]}]]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       LineColor->GrayLevel[0.35],
       FrontFaceColor->GrayLevel[0.35],
       BackFaceColor->GrayLevel[0.35],
       GraphicsColor->GrayLevel[0.35],
       FontSize->12,
       FontColor->GrayLevel[0.35]]},
     {
      StyleBox[
       TemplateBox[{
        "\"which is verified separately on each of the 4 sign regions (sign \
combinations of  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["z", "2"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["z", "3"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" )   \"", 
         StyleBox["\"\[CheckmarkedBox]\"", 14, 
          RGBColor[0.13, 0.55, 0.13], StripOnInput -> False], "\" ,  so  \"", 
         
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SuperscriptBox["k", "2"], " ", 
                RowBox[{"(", 
                  RowBox[{
                    
                    TemplateBox[{"g", "2", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "+", 
                    
                    TemplateBox[{"g", "3", "2"}, "Subsuperscript", SyntaxForm -> 
