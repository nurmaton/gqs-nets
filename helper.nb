     {"\<\"\"\>"},
     {
      StyleBox[
       TemplateBox[{"\"Thus, substituting the identities  \"", 
         StyleBox["\"\[FilledDiamond]\"", 13, 
          RGBColor[0., 0.45, 0.25], StripOnInput -> False], 
         "\"  into the numerator and the denominator of \"", 
         StyleBox["\"the given U-formula\"", Italic, 13, 
          RGBColor[0.85, 0.45, 0.], StripOnInput -> False], "\", we get\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox["\<\"the numerator identity:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{
            RowBox[{
             TemplateBox[{
               SubscriptBox["x", "1"]},
              "Abs"], " ", 
             SubscriptBox["H", "2"], " ", 
             SubscriptBox["H", "3"], " ", "t"}], "+", 
            RowBox[{
             SubscriptBox["e", "0"], " ", 
             SubscriptBox["e", "2"], " ", 
             SubscriptBox["H", "1"], " ", 
             SqrtBox[
              RowBox[{
               SubscriptBox["x", "1"], " ", 
               RowBox[{"\[ScriptCapitalD]", "(", 
                RowBox[{
                 SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], 
           "\[LongEqual]", 
           RowBox[{
            SubscriptBox["\[Xi]", "23"], " ", 
            SqrtBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["z", "2"], " ", 
                 SubscriptBox["z", "3"]}]},
              "Abs"]], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               TemplateBox[{
                 SubscriptBox["x", "1"]},
                "Abs"], " ", 
               SubscriptBox["h", "232"], " ", 
               SubscriptBox["h", "233"], " ", "t"}], "+", 
              RowBox[{
               SubscriptBox["e", "0"], " ", 
               SubscriptBox["h", "231"], " ", 
               SqrtBox[
                RowBox[{
                 SubscriptBox["x", "1"], " ", 
                 RowBox[{"\[ScriptCapitalD]", "(", 
                  RowBox[{
                   SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], ")"}]}]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       FontSize->14]},
     {
      StyleBox["\<\"the denominator identity:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
