       FontColor->GrayLevel[0.35]]},
     {
      StyleBox[
       TemplateBox[{"\"Thus, when  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"u", "<", "0"}], HoldForm], TraditionalForm], 
