        "RowDefault"],
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox["\<\"The following identities hold:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{
