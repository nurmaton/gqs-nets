            SubscriptBox["h", "233"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["e", "0"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["\[CurlyEpsilon]", "2"], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["\[CurlyEpsilon]", "3"], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], 
         "\"  symbolic, that is, for all their real values at once, which \
covers all their sign choices:\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"In case (a), both values of  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["\[Xi]", "23"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  occur, because the sign of  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["z", "2"], " ", 
              SubscriptBox["z", "3"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  is not constrained;  in case (b),  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["\[Xi]", "23"], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\",  because  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "2"], "\[LongEqual]", 
              RowBox[{
                RowBox[{"(", 
                  RowBox[{
                    
                    TemplateBox[{"g", "2", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}], " ", 
                RowBox[{"(", 
                  RowBox[{
                    
                    TemplateBox[{"g", "3", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], "-", "1"}], ")"}]}], ">", "0"}], 
            HoldForm], TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                
                TemplateBox[{"g", "i", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox], "-", "1"}], "\[LongEqual]", 
              FractionBox["1", 
