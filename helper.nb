Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"The derivation:  the formula for  \"", Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox["U", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True], Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        StyleBox["\"  in case (c) for  \"", Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"u", "<", "0"}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Given hypotheses and formulas, in addition to those \
above:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["t", "2"], "+", 
                SubscriptBox["t", "3"]}], "\[LongEqual]", 
              RowBox[{
                RowBox[{"2", " ", "K", " ", "m"}], "+", 
                RowBox[{"\[ImaginaryI]", " ", 
                  SuperscriptBox[
                  "K", "\[Prime]", MultilineFunction -> None]}]}]}], 
            HoldForm], TraditionalForm], TraditionalForm, Editable -> True], 
         "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"m", "\[Element]", "\[DoubleStruckCapitalZ]"}], HoldForm],
            TraditionalForm], TraditionalForm, Editable -> True], "\",   \"", 
         
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "m"], "\[LongEqual]", 
              SubscriptBox["S", "23"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["e", "2"], "\[LongEqual]", 
              SubscriptBox["e", "3"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"cn", "(", 
                RowBox[{"v", "+", 
                  RowBox[{"2", " ", "m", " ", "K"}]}], ")"}], "\[LongEqual]", 
              
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "m"], " ", 
                RowBox[{"cn", "(", "v", ")"}]}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"cn", "(", 
                RowBox[{"v", "\[MinusPlus]", 
                  RowBox[{"\[ImaginaryI]", " ", 
                    SuperscriptBox[
                    "K", "\[Prime]", MultilineFunction -> None]}]}], ")"}], 
              "\[LongEqual]", 
              FractionBox[
               RowBox[{
                 RowBox[{"\[PlusMinus]", "\[ImaginaryI]"}], " ", 
                 RowBox[{"dn", "(", "v", ")"}]}], 
               RowBox[{"k", " ", 
                 RowBox[{"sn", "(", "v", ")"}]}]]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\"    \"", 
         StyleBox["\"the shift formulas\"", Italic, 13, 
