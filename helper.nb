            SubscriptBox["z", "2"], " ", 
            SubscriptBox["z", "3"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               SubscriptBox["\[Xi]", "23"], " ", 
