Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"Step 2: the hypotheses after the permutation\"", Bold, 15, 
         RGBColor[0.35, 0.35, 0.35], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Verification: each hypothesis of the given panel, written \
with the hats, is compared with the hypotheses written without them.\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      TagBox[GridBox[{
         {
          StyleBox["\<\"(1)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"the eight sums \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Alpha]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Beta]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Gamma]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" are, up to sign, the eight sums \"", 
             TagBox[
              SubscriptBox["\[Alpha]", 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox["\[Beta]", 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox["\[Gamma]", 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[PlusMinus] \"", 
             TagBox[
              SubscriptBox["\[Delta]", 
               StyleBox["i+1", FontSlant -> "Italic"]], DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
           FontSize->14,
           FontColor->RGBColor[0.13, 0.55, 0.13]], 
          
          StyleBox["\<\"for i = 1, 2, 3, 4, by (1) of Step 1; so none of them \
is 0 modulo 2\[Pi]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(2)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Alpha]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\", \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Beta]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\", \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Gamma]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], "\", \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\" \[Element] (0, \[Pi])\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox["\<\"by (1) of Step 1: they are flat angles of the net\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(3)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], "1"], DisplayForm], "\" + \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], "2"], DisplayForm], "\" + \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], "3"], DisplayForm], "\" + \"", 
             
             TagBox[
              SubscriptBox[
               OverscriptBox["\[Delta]", "^"], "4"], DisplayForm], "\" = \"", 
             
             TagBox[
              SubscriptBox["\[Delta]", "2"], DisplayForm], "\" + \"", 
             TagBox[
              SubscriptBox["\[Delta]", "3"], DisplayForm], "\" + \"", 
             TagBox[
              SubscriptBox["\[Delta]", "4"], DisplayForm], "\" + \"", 
             TagBox[
              SubscriptBox["\[Delta]", "1"], DisplayForm], "\" = 2\[Pi]\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
           FontSize->14,
           FontColor->RGBColor[0.13, 0.55, 0.13]], 
          StyleBox["\<\"by (1) of Step 1\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(4)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["M", FontSlant -> "Italic"], "^"], "1"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["M", FontSlant -> "Italic"], "^"], "2"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["M", FontSlant -> "Italic"], "^"], "3"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["M", FontSlant -> "Italic"], "^"], "4"], 
              DisplayForm], "\" reads \"", 
             TagBox[
              SubscriptBox[
               StyleBox["M", FontSlant -> "Italic"], "2"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["M", FontSlant -> "Italic"], "3"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["M", FontSlant -> "Italic"], "4"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["M", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\", so that \"", 
             TagBox[
              OverscriptBox[
               StyleBox["M", FontSlant -> "Italic"], "^"], DisplayForm], 
             "\" = \"", 
             TagBox[
              StyleBox["M", FontSlant -> "Italic"], DisplayForm], "\" > 0\""},
            
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
           FontSize->14,
           FontColor->RGBColor[0.13, 0.55, 0.13]], 
          StyleBox["\<\"by (5) of Step 1\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(5)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["r", FontSlant -> "Italic"], "^"], "1"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["r", FontSlant -> "Italic"], "^"], "2"], 
              DisplayForm], "\", \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", FontSlant -> "Italic"], "^"], "1"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", FontSlant -> "Italic"], "^"], "4"], 
              DisplayForm], "\", \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["r", FontSlant -> "Italic"], "^"], "3"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["r", FontSlant -> "Italic"], "^"], "4"], 
              DisplayForm], "\", \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", FontSlant -> "Italic"], "^"], "2"], 
              DisplayForm], "\" = \"", 
             TagBox[
              SubscriptBox[
               OverscriptBox[
                StyleBox["s", FontSlant -> "Italic"], "^"], "3"], 
              DisplayForm], "\" read \"", 
             TagBox[
              SubscriptBox[
               StyleBox["s", FontSlant -> "Italic"], "2"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["s", FontSlant -> "Italic"], "3"], DisplayForm], 
             "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["r", FontSlant -> "Italic"], "2"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["r", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["s", FontSlant -> "Italic"], "4"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["s", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["r", FontSlant -> "Italic"], "3"], DisplayForm], 
             "\" = \"", 
             TagBox[
              SubscriptBox[
               StyleBox["r", FontSlant -> "Italic"], "4"], DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
