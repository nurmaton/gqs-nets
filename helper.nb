              RowBox[{
               SubscriptBox["x", "1"], " ", 
               RowBox[{"\[ScriptCapitalD]", "(", 
                RowBox[{
                 SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], 
