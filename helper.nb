       FontSize->13]},
     {"\<\"\"\>"},
     {
      StyleBox[
       TemplateBox[{"\"The identity  \"", 
         StyleBox["\"\[FilledDiamond]\"", 13, 
          RGBColor[0.55, 0.25, 0.7], StripOnInput -> False], 
         "\"  is verified separately on each sign region, with  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["h", "231"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["h", "232"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
