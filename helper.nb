                    SubscriptBox["z", "2"], " ", 
                    SubscriptBox["z", "3"]}]}], ")"}]}]}], "\[NotEqual]", 
              "0"}], HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True], "\" ;  we consider three possible cases:   (i)  \"", 
