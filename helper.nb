          TraditionalForm, Editable -> True], 
         "\",  holds pointwise and, together with  \"", 
         StyleBox["\"the parity formulas\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], "\",  gives\""},
        
