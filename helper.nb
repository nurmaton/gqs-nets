       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"test", "[", 
          RowBox[{
           RowBox[{"ReleaseHold", "@", "lhs"}], ",", 
           RowBox[{"ReleaseHold", "@", "rhs"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Verified\>\"", ",", 
           RowBox[{"Darker", "@", "Green"}], ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<FAILED\>\"", ",", "Red", ",", "Bold"}], "]"}]}], 
        "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
