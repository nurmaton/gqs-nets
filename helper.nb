            SubscriptBox["z", "2"], " ", 
            SubscriptBox["z", "3"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               SubscriptBox["\[Xi]", "23"], " ", 
               SuperscriptBox["k", "2"], " ", 
               SubscriptBox["x", "1"], " ", 
               TemplateBox[{"h", "231", "2"},
