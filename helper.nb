          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["\[Xi]", "ij"], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" ,  because  \"", 
