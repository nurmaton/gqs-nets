     {"\<\"\"\>"},
     {
      StyleBox[
       TemplateBox[{"\"Together, the numerator, denominator, and \"", 
         StyleBox["\"prefactor\"", Italic, 13, 
          RGBColor[0.8, 0.2, 0.5], StripOnInput -> False], 
         "\" identities, along with  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              TemplateBox[{
                RowBox[{"u", " ", 
                  SubscriptBox["z", "2"]}]}, "Sign"], "\[LongEqual]", 
              RowBox[{"-", 
                TemplateBox[{
                  SubscriptBox["z", "2"]}, "Sign"]}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" ,  give the formula  \"", 
         StyleBox["\"\[FivePointedStar]\"", 13, 
          RGBColor[0.1, 0.35, 0.75], StripOnInput -> False], 
         "\"  in case (a):\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"U", "\[LongEqual]", 
              FractionBox[
               RowBox[{
                 RowBox[{"(", 
                   TagBox[
                    RowBox[{
                    SubscriptBox["\[CurlyEpsilon]", "2"], " ", 
                    SubscriptBox["\[CurlyEpsilon]", "3"], " ", 
                    TemplateBox[{
                    SubscriptBox["z", "2"]}, "Sign"], " ", 
                    SqrtBox[
                    FractionBox[
                    RowBox[{
                    SubscriptBox["z", "2"], " ", 
                    SubscriptBox["z", "3"]}], 
                    RowBox[{
                    SubscriptBox["x", "1"], " ", 
                    SubscriptBox["x", "3"]}]]]}], HoldForm], ")"}], " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    TemplateBox[{
                    SubscriptBox["x", "1"]}, "Abs"], " ", 
                    SubscriptBox["H", "2"], " ", 
                    SubscriptBox["H", "3"], " ", "t"}], "+", 
                    RowBox[{
                    SubscriptBox["e", "0"], " ", 
                    SubscriptBox["e", "2"], " ", 
                    SubscriptBox["H", "1"], " ", 
                    SqrtBox[
                    RowBox[{
                    SubscriptBox["x", "1"], " ", 
                    RowBox[{"\[ScriptCapitalD]", "(", 
                    RowBox[{
                    SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}]}], ")"}]}], 
               RowBox[{
                 RowBox[{
                   SubscriptBox["z", "2"], " ", 
                   SubscriptBox["z", "3"]}], "+", 
                 RowBox[{"u", " ", 
                   SubscriptBox["x", "1"], " ", 
                   
                   TemplateBox[{"H", "1", "2"}, "Subsuperscript", SyntaxForm -> 
                    SubsuperscriptBox], " ", 
                   SuperscriptBox["t", "2"]}]}]]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\"      \"", 
         StyleBox["\"\[FivePointedStar]\"", 14, StripOnInput -> False]},
        "RowDefault"],
       StripOnInput->False,
       LineColor->RGBColor[0.1, 0.35, 0.75],
       FrontFaceColor->RGBColor[0.1, 0.35, 0.75],
       BackFaceColor->RGBColor[0.1, 0.35, 0.75],
       GraphicsColor->RGBColor[0.1, 0.35, 0.75],
       FontSize->14,
       FontColor->RGBColor[0.1, 0.35, 0.75]]},
     {
      StyleBox[
       TemplateBox[{"\"By the denominator identity, the denominators  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"k", " ", 
              RowBox[{"(", 
                RowBox[{"1", "-", 
                  RowBox[{
                    SubscriptBox["x", "1"], " ", 
                    SuperscriptBox["t", "2"]}]}], ")"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["z", "2"], " ", 
                SubscriptBox["z", "3"]}], "+", 
              RowBox[{"u", " ", 
                SubscriptBox["x", "1"], " ", 
                
                TemplateBox[{"H", "1", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox], " ", 
                SuperscriptBox["t", "2"]}]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  vanish for the same t, because  \"", 
         TagBox[
          FormBox[
           TagBox["k", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
