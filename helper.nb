             FractionBox[
              RowBox[{
               SubscriptBox["z", "2"], " ", 
               SubscriptBox["z", "3"]}], 
              RowBox[{
               SubscriptBox["\[Xi]", "23"], " ", 
               SqrtBox[
                TemplateBox[{
                  RowBox[{
                    SubscriptBox["z", "2"], " ", 
                    SubscriptBox["z", "3"]}]},
                 "Abs"]]}]],
             HoldForm]}], "\[LongEqual]", 
           SqrtBox[
            FractionBox[
             RowBox[{
              SubscriptBox["z", "2"], " ", 
              SubscriptBox["z", "3"]}], 
             RowBox[{
              SubscriptBox["x", "1"], " ", 
              SubscriptBox["x", "3"]}]]]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       FontSize->14]},
