     {
      StyleBox[
       TemplateBox[{"\"and, finally, \"", 
         StyleBox["\"the prefactor identity\"", Italic, 13, 
          RGBColor[0.8, 0.2, 0.5], StripOnInput -> False], "\" :\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{
            TagBox[
             FractionBox["1", 
              SqrtBox[
               TemplateBox[{
                 RowBox[{
                   SubscriptBox["x", "1"], " ", 
