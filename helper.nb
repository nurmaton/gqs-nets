Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"The derivation:  the formulas for  \"", Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["W", "2"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        StyleBox["\"  and  \"", Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["W", "1"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        StyleBox["\"  for  \"", Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"u", "<", "0"}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], Bold, 15, 
         RGBColor[0.1, 0.3, 0.7], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Given hypotheses and formulas, in addition to those \
above:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{"\"For  \"", 
         TagBox[
          FormBox[
           TagBox["i", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True], "\" = 1, 2 :\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["y", "i"], " ", 
                
                TemplateBox[{"q", "i", "2"}, "Subsuperscript", SyntaxForm -> 
                 SubsuperscriptBox]}], "\[LongEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["p", "i"], "\[LongEqual]", 
