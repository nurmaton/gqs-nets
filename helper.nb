                    SubscriptBox["z", "3"]}], ")"}]}]}, "Abs"]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  into \"", 
         StyleBox[
          TemplateBox[{"\"the case-(a)  \"", 
