   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"row", "[", 
      RowBox[{"{", 
       RowBox[{"desc_", ",", "lhs_", ",", "rhs_", ",", "test_"}], "}"}], 
      "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"desc", ",", 
       RowBox[{"Item", "[", 
        RowBox[{
