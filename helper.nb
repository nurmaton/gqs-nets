              TemplateBox[{
                RowBox[{
                  SubscriptBox["x", "1"], " ", 
                  SubscriptBox["x", "3"]}]}, "Abs"]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\" ,\""},
        "RowDefault"],
