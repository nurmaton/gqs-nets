           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  into the numerator and the denominator of \"", 
         StyleBox["\"the given case-(c) U-formula\"", Italic, 13, 
          RGBColor[0.85, 0.45, 0.], StripOnInput -> False], "\", we get\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox["\<\"the numerator identity:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{
            SubscriptBox["e", "0"], " ", 
