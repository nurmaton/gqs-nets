          FormBox[
           TagBox["\[FinalSigma]", HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" .\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"The sign  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"-", 
              SubscriptBox["e", "0"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  is a convention, because  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["e", "0"], HoldForm], TraditionalForm], 
