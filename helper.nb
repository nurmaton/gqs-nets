          TraditionalForm, Editable -> True]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{"sn", "(", 
            SubscriptBox["t", "i"], ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             SubscriptBox["\[CurlyEpsilon]", "i"], " ", 
             SqrtBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 TemplateBox[{"g", "i", "2"},
                  "Subsuperscript"], "-", "1"}], ")"}], " ", 
               TemplateBox[{"p", "i", "2"},
                "Subsuperscript"], " ", 
               TemplateBox[{"q", "i", "2"},
                "Subsuperscript"]}]]}], 
            RowBox[{"k", " ", 
             SubscriptBox["p", "i"], " ", 
             SubscriptBox["q", "i"]}]]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       FontSize->14]},
     {
      StyleBox[
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
           RowBox[{"cn", "(", 
            SubscriptBox["t", "i"], ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{
             SubscriptBox["\[CurlyEpsilon]", "i"], " ", 
             SqrtBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 TemplateBox[{"g", "i", "2"},
                  "Subsuperscript"], "-", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   SuperscriptBox["k", "\[Prime]",
                    MultilineFunction->None], ")"}], "2"]}], ")"}], " ", 
               TemplateBox[{"p", "i", "2"},
                "Subsuperscript"], " ", 
               TemplateBox[{"q", "i", "2"},
                "Subsuperscript"]}]]}], 
            RowBox[{"k", " ", 
             SubscriptBox["p", "i"], " ", 
             SubscriptBox["q", "i"]}]]}],
          HoldForm],
         TraditionalForm],
        TraditionalForm,
        Editable->True],
       StripOnInput->False,
       FontSize->14]},
     {
      StyleBox[
       TemplateBox[{
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                RowBox[{"{", 
                  RowBox[{"sn", ",", "cn", ",", "dn"}], "}"}], 
                "\[InvisibleApplication]", 
                RowBox[{"(", 
                  RowBox[{
                    SuperscriptBox[
                    "e", "\[Prime]", MultilineFunction -> None], " ", 
                    SubscriptBox["t", "i"]}], ")"}]}], "\[LongEqual]", 
              RowBox[{"{", 
                RowBox[{
                  RowBox[{
                    SuperscriptBox[
                    "e", "\[Prime]", MultilineFunction -> None], " ", 
                    RowBox[{"sn", "(", 
                    SubscriptBox["t", "i"], ")"}]}], ",", 
                  RowBox[{"cn", "(", 
                    SubscriptBox["t", "i"], ")"}], ",", 
                  RowBox[{"dn", "(", 
                    SubscriptBox["t", "i"], ")"}]}], "}"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\"    \"", 
         StyleBox["\"by the parity formulas\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->14]},
     {"\<\"\"\>"},
     {
      StyleBox["\<\"Verification:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{"\"By  \"", 
         StyleBox["\"the Pythagorean relations\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{"dn", "(", 
                SubscriptBox["t", "i"], ")"}], "\[LongEqual]", 
              SubscriptBox["g", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" :   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"sn", "(", 
                 SubscriptBox["t", "i"], ")"}], "2"], "\[LongEqual]", 
              FractionBox[
               RowBox[{"1", "-", 
                 
                 TemplateBox[{"g", "i", "2"}, "Subsuperscript", SyntaxForm -> 
                  SubsuperscriptBox]}], 
               SuperscriptBox["k", "2"]]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\"   \"", 
         StyleBox["\"\[CheckmarkedBox]\"", 14, 
          RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"By  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["g", "i"], "\[LongEqual]", 
              FractionBox["1", 
               SqrtBox[
                RowBox[{"1", "+", 
                  FractionBox["1", 
                   SubscriptBox["z", "i"]]}]]]}], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "2"], "\[LongEqual]", 
              RowBox[{
                RowBox[{"-", "u"}], " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                   SuperscriptBox["k", "\[Prime]", MultilineFunction -> None],
                    ")"}], "2"]}]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "\[Prime]", MultilineFunction -> None], 
              "\[LongEqual]", 
              FractionBox["1", 
               SqrtBox[
                RowBox[{"1", "-", "u"}]]]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\" :   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              FractionBox[
               RowBox[{"1", "-", 
                 
                 TemplateBox[{"g", "i", "2"}, "Subsuperscript", SyntaxForm -> 
