            RowBox[{
              SubscriptBox["H", "3"], "\[NotEqual]", "0"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" ,  so the divisions by  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["H", "3"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\"  are legitimate there.\""},
        "RowDefault"],
