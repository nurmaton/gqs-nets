       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{"\"By  \"", 
         StyleBox["\"the Pythagorean relations\"", Italic, 13, 
          RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], "\" :   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"sn", "(", "\[FinalSigma]", ")"}], "2"], 
              "\[LongEqual]", 
