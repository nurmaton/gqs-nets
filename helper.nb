Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"The parameter normalization for  \"", Bold, 15, 
         RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"u", "<", "0"}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], Bold, 15, 
         RGBColor[0.75, 0.35, 0.05], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
