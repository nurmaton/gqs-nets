         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"sn", "(", "\[FinalSigma]", ")"}], "2"], 
              "\[LongEqual]", 
              RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"cn", "(", "\[FinalSigma]", ")"}], "2"]}], 
              "\[LongEqual]", 
              RowBox[{"1", "-", 
                RowBox[{
                  SubscriptBox["x", "1"], " ", 
                  SuperscriptBox["t", "2"]}]}]}], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], "\"   \"", 
