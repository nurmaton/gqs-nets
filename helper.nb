        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"Hence, substituting the identities  \"", 
         StyleBox["\"\[FilledCircle]\"", 13, 
          RGBColor[0.55, 0.33, 0.1], StripOnInput -> False], 
         "\"  and the equalities  \"", 
         TagBox[
