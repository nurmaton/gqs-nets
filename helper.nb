                RowBox[{"1", "-", "u"}]]]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                
                TemplateBox[{"g", "i", "2"}, "Subsuperscript", SyntaxForm -> 
