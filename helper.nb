           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" ,   hence   \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"k", "\[LongEqual]", 
              SqrtBox[
               RowBox[{
                 RowBox[{"(", 
