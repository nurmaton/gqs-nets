                   RowBox[{"2", " ", "k", " ", 
                    SubscriptBox["g", "i"], " ", 
                    SubscriptBox["g", "j"]}]]}], HoldForm], TraditionalForm], 
              TraditionalForm, Editable -> True], "\":   \"", 
