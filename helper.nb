                    SubscriptBox["\[Theta]", "1"], "/", "2", ")"}], 
                   DisplayForm], "\")\""}, "RowDefault"], TraditionalForm], 
               FormBox["\"2\"", TraditionalForm]], DisplayForm], "\" = \"", 
             TemplateBox[{"\"-\"", 
               TagBox[
                FormBox[
                 RowBox[{"sin", "(", 
