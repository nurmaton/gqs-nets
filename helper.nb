     {
      StyleBox[
       TemplateBox[{"\"The identity  \"", 
         StyleBox["\"\[FivePointedStar]\"", 13, 
          RGBColor[0.1, 0.35, 0.75], StripOnInput -> False], 
         "\"  is also verified separately on each sign region, with  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["H", "1"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
