          RGBColor[0.13, 0.55, 0.13], StripOnInput -> False], 
         "\"   ,  which is nonzero by the choice of  \"", 
         TagBox[
          FormBox[
           TagBox["t", HoldForm], TraditionalForm], TraditionalForm, Editable -> 
          True]},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox[
       TemplateBox[{"\"Because  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["e", "2"], "\[LongEqual]", 
