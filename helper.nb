 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox[
        "\"The derivation:  the sign identity in the case  \"", Bold, 15, 
         RGBColor[0.45, 0.15, 0.6], StripOnInput -> False], 
        StyleBox[
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SuperscriptBox["k", "2"], "\[LongEqual]", 
              RowBox[{
                RowBox[{"(", 
