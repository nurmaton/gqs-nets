               RowBox[{
                SubscriptBox["x", "1"], ",", "t"}], ")"}]}]]}], 
           "\[LongEqual]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"k", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 TemplateBox[{
                   SubscriptBox["x", "1"]},
                  "Abs"], " ", 
