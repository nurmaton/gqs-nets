        "RowDefault"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox["\<\"which are verified separately on each sign region:\"\>",
       StripOnInput->False,
       FontSize->13]},
     {
      TagBox[GridBox[{
         {
          StyleBox[
           TemplateBox[{
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  SubscriptBox["z", "2"], ">", "0"}], HoldForm], 
