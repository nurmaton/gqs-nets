     RowBox[{"i", " ", "R_", 
      RowBox[{"{", 
       RowBox[{">", "0"}], "}"}]}], ",", 
     RowBox[{"R_", 
      RowBox[{"{", 
       RowBox[{"<", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"written", " ", "p", " ", "q"}], "=", "rho"}], ",", 
     RowBox[{"i", " ", "rho"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "rho"}], " ", "with", " ", "an", " ", "atom", " ", 
        "rho"}], ">", "0"}], ";", 
      RowBox[{
       RowBox[{"the", " ", "sign", " ", "s", " ", "of", " ", 
        RowBox[{"p", "^", "2"}], " ", 
        RowBox[{"q", "^", "2"}], " ", "is", " ", "then"}], "+", "1"}]}], ",", 
     
     RowBox[{"-", "1"}], ",", 
     RowBox[{"+", "1"}], ",", "and", ",", 
     RowBox[{"by", " ", "the", " ", "given", " ", "sign", " ", "identities"}],
      ",", 
     RowBox[{
      RowBox[{
       RowBox[{
       "s", " ", "is", " ", "also", " ", "the", " ", "sign", " ", "of", " ", 
        RowBox[{"g", "^", "2"}]}], "-", 
       RowBox[{"1", " ", "and", " ", "of", " ", 
        RowBox[{"g", "^", "2"}]}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "'"}], "^", "2."}], " ", "On", " ", "each", " ", 
        "class", " ", "the", " ", "atoms", " ", "A"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"s", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g", "^", "2"}], "-", "1"}], ")"}]}], "]"}], " ", "and", 
        " ", "B"}], "=", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"s", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g", "^", "2"}], "-", 
            RowBox[{
             RowBox[{"k", "'"}], "^", "2"}]}], ")"}]}], "]"}], " ", "are", 
        " ", "real", " ", "principal", " ", "roots", " ", "of", " ", 
        "positive", " ", "radicands"}]}]}], ",", 
     RowBox[{
      RowBox[{
      "and", " ", "every", " ", "radical", " ", "occurring", " ", "in", " ", 
       "the", " ", "given", " ", "and", " ", "tested", " ", "formulas", " ", 
       "resolves", " ", "into", " ", "a", " ", "product", " ", "of", " ", 
       "these", " ", "atoms"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "each", " ", "resolution", " ", "is", " ", "certified", " ", "by", " ", 
       "squaring"}]}], ",", 
     RowBox[{"which", " ", "is", " ", "a", " ", "rational", " ", "identity"}],
      ",", 
     RowBox[{
     "and", " ", "both", " ", "sides", " ", "are", " ", "nonnegative", " ", 
