     {"\<\"\"\>"},
     {
      StyleBox["\<\"Verification:\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TemplateBox[{"\"in this case  \"", 
