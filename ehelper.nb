Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"Claim 3: every pair\"", Bold, 15, 
         RGBColor[0., 0.55, 0.55], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Verification: by Claim 1, the numbers of a pair \
prescribed from a neighbouring pair agree with both quadruples it receives \
from it, and pass back to that neighbouring pair its own quadruples, because \
the reversal and the swap are their own inverses; by Claim 2, the \
prescriptions around every square of four pairs close up, and any two paths \
through neighbouring pairs between two pairs differ by such squares. So the \
numbers prescribed for a pair do not depend on the neighbouring pair they are \
prescribed from.\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      StyleBox[
       TagBox[GridBox[{
          {
           
           TemplateBox[{
            "\"    \"", 
             "\"every neighbouring pair receives quadruples that agree with \
the relations of the case of its row  \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"]},
          {
           
           TemplateBox[{
            "\"    \"", 
             "\"the prescriptions around every square of four pairs close up  \
\"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"]},
          {
           
           TemplateBox[{
            "\"    \"", 
             "\"the numbers prescribed for every pair do not depend on the \
neighbouring pair they are prescribed from  \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"]}
         },
         DefaultBaseStyle->"Column",
         GridBoxAlignment->{"Columns" -> {{Left}}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
         GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.5}}}],
        "Column"],
       StripOnInput->False,
       FontSize->13]},
     {
      StyleBox["\<\"Together, these give Claim 3.\"\>",
       StripOnInput->False,
       FontSize->13]}
    },
