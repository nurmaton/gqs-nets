                    StyleBox["\"t\"", Italic, StripOnInput -> False], 
                    "2"]}]}], ")"}]}]]}], HoldForm], TraditionalForm], 
              DisplayForm]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
