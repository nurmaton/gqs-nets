         TemplateBox[{"\"Claim 1.  In each case, the relations determine  \"", 
           TagBox[
            FormBox[
             TagBox[
              RowBox[{"{", 
                RowBox[{
                  SubscriptBox["\[Alpha]", "2"], ",", 
                  SubscriptBox["\[Beta]", "2"], ",", 
