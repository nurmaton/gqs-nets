             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               RowBox[{
                 TagBox[
                  RowBox[{"{", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "4"], "_"], ",", 
                    OverscriptBox[
                    SubscriptBox["\[Beta]", "4"], "_"], ",", 
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "4"], "_"], ",", 
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "4"], "_"]}], "}"}], HoldForm], 
                 "\[LongEqual]", 
                 RowBox[{"{", 
                   RowBox[{
                    RowBox[{"\[Pi]", "-", 
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "1"], "_"]}], ",", 
                    RowBox[{"\[Pi]", "-", 
                    OverscriptBox[
                    SubscriptBox["\[Beta]", "1"], "_"]}], ",", 
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "1"], "_"], ",", 
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "1"], "_"]}], "}"}]}], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]}
        },
        DefaultBaseStyle->"Column",
        GridBoxAlignment->{"Columns" -> {{Left}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
        GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.4}}}],
       "Column"]},
     {
      StyleBox[
       TemplateBox[{"\"Since  \[Alpha], \[Beta], \[Gamma], \[Delta]  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            OverscriptBox[
             SubscriptBox["\[Alpha]", "1"], "_"], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            OverscriptBox[
             SubscriptBox["\[Beta]", "1"], "_"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            OverscriptBox[
             SubscriptBox["\[Gamma]", "1"], "_"], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            OverscriptBox[
             SubscriptBox["\[Delta]", "1"], "_"], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], 
         "\"  lie in  (0, \[Pi])  by the hypotheses, it follows that their \
complements to \[Pi] lie in  (0, \[Pi])  as well;  hence all numbers and \
barred numbers at the vertices 2, 3, 4 lie in  (0, \[Pi]),  all sines in the \
definitions of  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["a", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["b", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["c", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\", \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["d", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\"  are positive, and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["M", "i"], ">", "0"}], HoldForm], TraditionalForm],
           TraditionalForm, Editable -> True], 
         "\"  for each  i = 1, 2, 3, 4.  Together, these give Claim 2.\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]}
    },
    DefaultBaseStyle->"Column",
