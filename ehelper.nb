     {
      StyleBox[
       TemplateBox[{"\"Dihedral angles of \"", 
         TagBox[
          StyleBox["Q", FontSlant -> "Italic"], DisplayForm], 
         "\" for the parameter \"", 
         TagBox[
          StyleBox["t", FontSlant -> "Italic"], DisplayForm], 
         "\" and the sign \"", 
         TagBox[
          SubscriptBox[
           StyleBox["e", FontSlant -> "Italic"], "0"], DisplayForm], 
         "\", after the renumbering:\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->14,
       FontWeight->Bold]},
     {
      StyleBox[
       TagBox[GridBox[{
          {
           TemplateBox[{
             TagBox[
              RowBox[{"cot", "(", 
                SubscriptBox["\[Theta]", "1"], "/", "2", ")"}], DisplayForm], 
             "\" = \"", 
             TagBox[
              StyleBox["t", FontSlant -> "Italic"], DisplayForm]},
            "RowDefault"]},
          {
           TemplateBox[{
             TagBox[
              RowBox[{"cot", "(", 
                SubscriptBox["\[Theta]", "2"], "/", "2", ")"}], DisplayForm], 
             "\" = \"", 
             TagBox[
              FormBox[
               TagBox[
                FractionBox[
                 RowBox[{
                   SubscriptBox["\"\[CurlyEpsilon]\"", "2"], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    StyleBox["\"t\"", Italic, StripOnInput -> False], " ", 
                    SqrtBox[
                    RowBox[{
                    StyleBox["\"u\"", Italic, StripOnInput -> False], " ", 
                    SubscriptBox[
                    StyleBox["\"x\"", Italic, StripOnInput -> False], "1"], 
                    " ", 
                    SubscriptBox[
                    StyleBox["\"y\"", Italic, StripOnInput -> False], "2"], 
                    " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    SubscriptBox[
                    StyleBox["\"z\"", Italic, StripOnInput -> False], "2"]}], 
                    ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    StyleBox["\"u\"", Italic, StripOnInput -> False], " ", 
                    SubscriptBox[
                    StyleBox["\"z\"", Italic, StripOnInput -> False], 
                    "2"]}]}], ")"}]}]]}], "+", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["\"e\"", Italic, StripOnInput -> False], "0"], 
                    " ", 
                    SubscriptBox[
                    StyleBox["\"e\"", Italic, StripOnInput -> False], "2"], 
                    " ", 
                    SqrtBox[
                    RowBox[{
                    StyleBox["\"u\"", Italic, StripOnInput -> False], " ", 
                    SubscriptBox[
                    StyleBox["\"y\"", Italic, StripOnInput -> False], "2"], 
                    " ", 
                    SubscriptBox[
                    StyleBox["\"z\"", Italic, StripOnInput -> False], "2"], 
                    " ", 
                    TemplateBox[{
                    StyleBox["\"D\"", Italic, StripOnInput -> False], "\"(\"", 
                    SubscriptBox[
                    StyleBox["\"x\"", Italic, StripOnInput -> False], "1"], 
                    "\", \"", 
                    StyleBox["\"t\"", Italic, StripOnInput -> False], 
                    "\")\""}, "RowDefault"]}]]}]}], ")"}]}], 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["\"y\"", Italic, StripOnInput -> False], "2"], 
                   " ", 
                   StyleBox["\"u\"", Italic, StripOnInput -> False], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["\"z\"", Italic, StripOnInput -> False], "2"], 
                    "+", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["\"x\"", Italic, StripOnInput -> False], "1"], 
