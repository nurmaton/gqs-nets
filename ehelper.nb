                  SubscriptBox["\[Delta]", "4"]}], "\[LongEqual]", 
                RowBox[{"2", " ", "\[Pi]"}]}], HoldForm], TraditionalForm], 
            TraditionalForm, Editable -> True], "\",   and  \"", 
           TemplateBox[{
             TemplateBox[{
               TagBox[
