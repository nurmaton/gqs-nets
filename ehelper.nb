              DisplayForm], "\" > 0 and \"", 
             TagBox[
              SubscriptBox["\[CurlyEpsilon]", "1"], DisplayForm], 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], "1"], DisplayForm], 
