            FormBox[
             TagBox[
              RowBox[{"{", 
                RowBox[{
                  SubscriptBox["\[Alpha]", "4"], ",", 
                  SubscriptBox["\[Beta]", "4"], ",", 
                  SubscriptBox["\[Gamma]", "4"], ",", 
                  SubscriptBox["\[Delta]", "4"]}], "}"}], HoldForm], 
             TraditionalForm], TraditionalForm, Editable -> True], 
           "\"  uniquely,   \"", 
