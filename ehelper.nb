Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox[
        "\"Claim 3:  the half sums, the quantities  \
\\!\\(\\*SubscriptBox[\\(f\\), \\(i\\)]\\)  and  \
\\!\\(\\*SubscriptBox[\\(M\\), \\(i\\)]\\)\"", Bold, 15, 
         RGBColor[0., 0.5, 0.5], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Verification:  the following identities hold for an \
arbitrary quadruple, hence at each vertex  i = 1, 2, 3, 4 :\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      TagBox[GridBox[{
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    SubscriptBox["\[Sigma]", "i"]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "+", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    RowBox[{"-", 
                    SubscriptBox["\[Alpha]", "i"]}], "-", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "-", 
                    SubscriptBox["\[Beta]", "i"], "-", 
                    SubscriptBox["\[Gamma]", "i"], "+", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], "\[LongEqual]", 
                  RowBox[{
                    SubscriptBox["\[Alpha]", "i"], "-", 
                    SubscriptBox["\[Beta]", "i"], "+", 
                    SubscriptBox["\[Gamma]", "i"], "-", 
                    SubscriptBox["\[Delta]", "i"]}]}], HoldForm], 
               TraditionalForm], TraditionalForm, Editable -> True], 
             "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{
                    SubscriptBox["f", "i"], "-", "1"}], "\[LongEqual]", 
                  FractionBox[
                   RowBox[{
                    RowBox[{"sin", "(", 
                    SubscriptBox["\[Sigma]", "i"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], 
                   RowBox[{
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], ")"}]}]]}], 
                HoldForm], TraditionalForm], TraditionalForm, Editable -> 
              True], "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]},
         {
          StyleBox[
           TemplateBox[{"\"        \"", 
             TagBox[
              FormBox[
               TagBox[
                RowBox[{
                  RowBox[{"1", "-", 
                    SubscriptBox["M", "i"]}], "\[LongEqual]", 
                  FractionBox[
                   RowBox[{
                    RowBox[{"sin", "(", 
                    SubscriptBox["\[Sigma]", "i"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    RowBox[{
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], "-", 
                    SubscriptBox["\[Beta]", "i"]}], ")"}]}], 
                   RowBox[{
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Alpha]", "i"], "_"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Beta]", "i"], "_"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Gamma]", "i"], "_"], ")"}], " ", 
                    RowBox[{"sin", "(", 
                    OverscriptBox[
                    SubscriptBox["\[Delta]", "i"], "_"], ")"}]}]]}], 
                HoldForm], TraditionalForm], TraditionalForm, Editable -> 
              True], "\"   \"", 
             StyleBox["\"\[CheckmarkedBox]\"", 14, 
              RGBColor[0.13, 0.55, 0.13], StripOnInput -> False]},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13]}
        },
        DefaultBaseStyle->"Column",
        GridBoxAlignment->{"Columns" -> {{Left}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
        GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.4}}}],
       "Column"]},
     {
      StyleBox[
       TemplateBox[{
        "\"The right-hand sides of the first four identities are, up to sign, \
numbers  \"", 
         TemplateBox[{
           TagBox[
            FormBox[
             TagBox[
              SubscriptBox["\[Alpha]", "i"], HoldForm], TraditionalForm], 
            TraditionalForm, Editable -> True], "\" \[PlusMinus] \"", 
           TagBox[
            FormBox[
             TagBox[
              SubscriptBox["\[Beta]", "i"], HoldForm], TraditionalForm], 
            TraditionalForm, Editable -> True], "\" \[PlusMinus] \"", 
           TagBox[
            FormBox[
             TagBox[
              SubscriptBox["\[Gamma]", "i"], HoldForm], TraditionalForm], 
            TraditionalForm, Editable -> True], "\" \[PlusMinus] \"", 
           TagBox[
            FormBox[
             TagBox[
              SubscriptBox["\[Delta]", "i"], HoldForm], TraditionalForm], 
            TraditionalForm, Editable -> True]}, "RowDefault"], 
         "\" ,  which are  \[NotEqual] 0  (mod 2\[Pi])  by the hypothesis and \
Claim 1;  hence  \"", 
         TagBox[
          FormBox[
           TagBox[
            SubscriptBox["\[Sigma]", "i"], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Alpha]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Gamma]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              OverscriptBox[
               SubscriptBox["\[Delta]", "i"], "_"], "-", 
              SubscriptBox["\[Beta]", "i"]}], HoldForm], TraditionalForm], 
          TraditionalForm, Editable -> True], 
         "\"  are not in  \[Pi]\[DoubleStruckCapitalZ],  and their sines are \
nonzero.  Since the sines of the barred numbers are nonzero by Claim 2, it \
follows from the last two identities that  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["f", "i"], "\[NotEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["M", "i"], "\[NotEqual]", "1"}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" .  Hence  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              RowBox[{
                SubscriptBox["\[CurlyEpsilon]", "i"], "\[LongEqual]", 
                TemplateBox[{
                  RowBox[{"sin", "(", 
                    SubscriptBox["\[Sigma]", "i"], ")"}]}, "Sign"]}], 
              "\[Element]", 
              RowBox[{"{", 
                RowBox[{"\[PlusMinus]", "1"}], "}"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], "\",  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{
              SubscriptBox["z", "i"], "\[LongEqual]", 
              FractionBox["1", 
               RowBox[{
                 SubscriptBox["f", "i"], "-", "1"}]]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\"  is well defined and nonzero, and  \"", 
         TagBox[
          FormBox[
           TagBox[
            RowBox[{"\[Chi]", "\[Element]", 
              RowBox[{"{", 
                RowBox[{"\[PlusMinus]", "1"}], "}"}]}], HoldForm], 
           TraditionalForm], TraditionalForm, Editable -> True], 
         "\" .  Together, these give Claim 3.\""},
        "RowDefault"],
       StripOnInput->False,
       FontSize->13]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
   "Column"],
  Background->RGBColor[0.93, 0.9650000000000001, 0.9650000000000001],
