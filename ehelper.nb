           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              RowBox[{"cot", "(", 
                SubscriptBox["\[Theta]", "4"], "/", "2", ")"}], DisplayForm], 
             "\" at \"", 
             TagBox[
              SubscriptBox[
               StyleBox["e", FontSlant -> "Italic"], "0"], DisplayForm], 
             "\" = 1  minus  \"", 
             TagBox[
              RowBox[{"cot", "(", 
                SubscriptBox["\[Theta]", "4"], "/", "2", ")"}], DisplayForm], 
             "\" at \"", 
             TagBox[
              SubscriptBox[
