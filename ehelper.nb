Cell[BoxData[
 PanelBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\"Claim 3: the corner faces fit\"", Bold, 15, 
         RGBColor[0., 0.55, 0.55], StripOnInput -> False], 
        TemplateBox[{20}, "Spacer1"], 
        FrameBox[
         StyleBox["\"Verified\"", Bold, 
          GrayLevel[1], 13, StripOnInput -> False], Background -> 
         RGBColor[0.13, 0.55, 0.13], FrameStyle -> None, RoundingRadius -> 7, 
         FrameMargins -> {{12, 12}, {4, 4}}, StripOnInput -> False]},
       "RowDefault"]},
     {
      StyleBox["\<\"Verification: Bricard's equations make the angle between \
the free edges at each vertex that of the corner face.\"\>",
       StripOnInput->False,
       FontSize->13,
       FontWeight->Bold]},
     {
      TagBox[GridBox[{
         {
          StyleBox["\<\"(1)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "1"], "(", 
                StyleBox["Z", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "1"], ")"}], 
              DisplayForm], "\" = \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "2"], "(", 
                StyleBox["Z", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "2"], ")"}], 
              DisplayForm], "\" = \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "3"], "(", 
                StyleBox["U", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "2"], ")"}], 
              DisplayForm], "\" = \"", 
             TagBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["P", FontSlant -> "Italic"], "4"], "(", 
                StyleBox["U", FontSlant -> "Italic"], ", ", 
                SubscriptBox[
                 StyleBox["W", FontSlant -> "Italic"], "1"], ")"}], 
              DisplayForm], "\" = 0\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[FilledSmallCircle]\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.45],
           FrontFaceColor->GrayLevel[0.45],
           BackFaceColor->GrayLevel[0.45],
           GraphicsColor->GrayLevel[0.45],
           FontSize->12,
           FontColor->GrayLevel[0.45]], 
          StyleBox["\<\"the assumption\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0.5],
           FrontFaceColor->GrayLevel[0.5],
           BackFaceColor->GrayLevel[0.5],
           GraphicsColor->GrayLevel[0.5],
           FontSize->12,
           FontColor->GrayLevel[0.5]]},
         {
          StyleBox["\<\"(2)\"\>",
           StripOnInput->False,
           FontSize->13], 
          StyleBox[
           TemplateBox[{"\"cos\[ThinSpace]\"", 
             TagBox[
              RowBox[{"\[Angle]", 
                SubscriptBox[
                 StyleBox["B", FontSlant -> "Italic"], 
                 StyleBox["i", FontSlant -> "Italic"]], 
                SubscriptBox[
                 StyleBox["A", FontSlant -> "Italic"], 
                 StyleBox["i", FontSlant -> "Italic"]], 
                SubscriptBox[
                 StyleBox["C", FontSlant -> "Italic"], 
                 StyleBox["i", FontSlant -> "Italic"]]}], DisplayForm], 
             "\" = cos\[ThinSpace]\"", 
             TagBox[
              SubscriptBox["\[Beta]", 
               StyleBox["i", FontSlant -> "Italic"]], DisplayForm], 
             "\",   i = 1, 2, 3, 4\""},
            "RowDefault"],
           StripOnInput->False,
           FontSize->13], 
          StyleBox["\<\"\[CheckmarkedBox]\"\>",
           StripOnInput->False,
           LineColor->RGBColor[0.13, 0.55, 0.13],
           FrontFaceColor->RGBColor[0.13, 0.55, 0.13],
           BackFaceColor->RGBColor[0.13, 0.55, 0.13],
           GraphicsColor->RGBColor[0.13, 0.55, 0.13],
           FontSize->14,
           FontColor->RGBColor[0.13, 0.55, 0.13]], 
          StyleBox[
           TemplateBox[{"\"by Claim 2, with (\"", 
             TagBox[
              StyleBox["X", FontSlant -> "Italic"], DisplayForm], "\", \"", 
             TagBox[
              StyleBox["Y", FontSlant -> "Italic"], DisplayForm], "\") = (\"", 
             TagBox[
              StyleBox["Z", FontSlant -> "Italic"], DisplayForm], "\", \"", 
             TagBox[
              SubscriptBox[
               StyleBox["W", FontSlant -> "Italic"], "1"], DisplayForm], 
             "\"), (\"", 
             TagBox[
              StyleBox["Z", FontSlant -> "Italic"], DisplayForm], "\", \"", 
