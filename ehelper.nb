                FormBox[
                 TagBox[
                  SubscriptBox["\[Delta]", "i"], HoldForm], TraditionalForm], 
                TraditionalForm, Editable -> True]}, "RowDefault"], 
             "\" \[NotEqual] 0  (mod 2\[Pi])  for all choices of the signs \
\[PlusMinus]\""}, "RowDefault"], "\"  for  i = 2, 3, 4.\""}, "RowDefault"], 
         Bold, 13, 
